# Logistaas Ads Intelligence System — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# On Render: set each variable in the service's "Environment" tab (Dashboard → Service → Environment).

# ── Application ──────────────────────────────────────────────────────────────
# Used by: api/server.py, api/auth.py
# On Render: APP_ENV=production (enables secure cookies over HTTPS)
# Locally:   APP_ENV=development (disables secure flag so HTTP cookies work)
APP_ENV=production

# ── Internal Auth ─────────────────────────────────────────────────────────────
# Used by: api/auth.py (all authenticated endpoints)
#
# APP_SECRET_KEY — long random secret for signing session cookies.
#   Generate with: python -c "import secrets; print(secrets.token_hex(32))"
#   or:            openssl rand -hex 32
APP_SECRET_KEY=replace_with_long_random_secret

# AUTH_USERS_JSON — JSON array of internal users (no database required).
#
# Secure mode (recommended) — use password_hash generated by:
#   python scripts/create_user_hash.py
#   Format:
#   [
#     {"username":"youssef","password_hash":"pbkdf2_sha256$...","role":"admin"},
#     {"username":"kareem","password_hash":"pbkdf2_sha256$...","role":"viewer"},
#     {"username":"mdr","password_hash":"pbkdf2_sha256$...","role":"mdr"}
#   ]
#
# Temporary fallback mode — use password (plain text) when hash generation is
# unavailable (e.g., no Render shell access):
#   ⚠️ Plain password mode is for temporary internal use only.
#   Do not use in production long-term. Replace with hashed passwords when possible.
#   [
#     {"username":"youssef","password":"Ypor@youssef123?","role":"admin"},
#     {"username":"kareem","password":"Kareem@123","role":"viewer"},
#     {"username":"mdr","password":"MDR@123","role":"mdr"}
#   ]
AUTH_USERS_JSON=[]

# ── API Protection (optional — for API-only run triggers) ─────────────────────
# Used by: api/server.py — POST /run/daily, /run/weekly, /run/monthly
# Dashboard users should use cookie-based login instead of this token.
# If not set, run endpoints still accept admin cookie sessions.
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=

# ── HubSpot CRM ──────────────────────────────────────────────────────────────
# Used by: connectors/hubspot_pull.py (all schedulers)
# Private app token — generate in HubSpot → Settings → Integrations → Private Apps
HUBSPOT_API_KEY=

# ── Windsor.ai ───────────────────────────────────────────────────────────────
# Used by: connectors/windsor_pull.py (all schedulers)
# API key and account ID from Windsor.ai dashboard
WINDSOR_API_KEY=
WINDSOR_ACCOUNT_ID=

# PR-ADS-162H: ADVISOR_MODE, ANTHROPIC_API_KEY, SENDGRID_API_KEY,
# REPORT_SENDER_EMAIL and REPORT_RECIPIENT_EMAIL are no longer read by anything.
# The weekly / monthly advisor report they configured is neither generated nor
# emailed.

# ── Google Ads API ───────────────────────────────────────────────────────────
# Used by: connectors/oct_uploader.py (not yet built — leave blank until available)
# Required when OCT uploads are enabled.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=3059734490

# ── Meta (Facebook/Instagram) Ads — read-only spend (PR-ADS-171A) ────────────
# Used by: connectors/meta_ads.py (server-side only). GET requests only — the
# connector never creates, edits, pauses or deletes anything in Meta. A token
# is sent in the Authorization header only and is never logged or returned.
#
# A CREDENTIAL SET is one token plus the ad accounts that token reads.
#
# Set 1 (unsuffixed):
#   META_ADS_ACCESS_TOKEN — a System User access token with the `ads_read`
#                           permission and access to the ad account(s).
#   META_AD_ACCOUNT_ID    — one ad account id, or several separated by commas.
#                           Digits; a leading "act_" and spaces are accepted.
# Set 2 … 5 (suffix _2 … _5) — for an ad account in ANOTHER Business
# portfolio, which needs its own System User and its own token:
#   META_ADS_ACCESS_TOKEN_2, META_AD_ACCOUNT_ID_2
#
# Nothing set → Meta is "not connected": no network call, nothing written.
# A set with only one of its two variables is not used and the run is partial.
# An account id listed in two sets → nothing syncs (`meta_ads_misconfigured`).
# Removing an account from its list keeps its stored history (docs/52 §6).
#
# META_API_VERSION      — OPTIONAL. Overrides `meta_ads.api_version` in
#                         config/thresholds.yaml, e.g. "v27.0".
# META_APP_SECRET       — OPTIONAL (META_APP_SECRET_2 … for the other sets). If
#                         the Meta app requires an app secret proof, set it
#                         and that set's calls carry one.
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN_2=
META_AD_ACCOUNT_ID_2=
META_API_VERSION=
META_APP_SECRET=
META_APP_SECRET_2=

# ── Mailchimp Marketing API (read-only — PR-ADS-151) ─────────────────────────
# Used by: connectors/mailchimp_pull.py (server-side only). PULL ONLY — the
# connector issues GET requests exclusively; it never creates, edits, sends,
# schedules, or deletes anything in Mailchimp. Credentials are server-side only
# and are NEVER exposed through the API or frontend.
#
# MAILCHIMP_API_KEY       — Marketing API key (Account → Extras → API keys). This
#                           is the ONLY required Mailchimp variable: a present key
#                           with a valid -usXX suffix enables the connector and
#                           derives the data centre automatically. Key absent →
#                           "not configured" and no network calls.
# MAILCHIMP_SERVER_PREFIX — OPTIONAL explicit data-centre prefix, e.g. "us21".
#                           Only needed to override the key-derived prefix.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
